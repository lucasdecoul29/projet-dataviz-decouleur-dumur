@prefix divvy: <http://example.org/divvy#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/divvy> a owl:Ontology ;
    rdfs:label "Ontologie Divvy Bike Sharing"@fr ;
    rdfs:comment "Ontologie décrivant les trajets Divvy, les stations, les périodes, les véhicules et les catégories d'utilisateurs."@fr .

divvy:annee a owl:DatatypeProperty ;
    rdfs:domain divvy:Periode ;
    rdfs:range xsd:integer .

divvy:concerneCategorie a owl:ObjectProperty ;
    rdfs:domain divvy:RepartitionCategorie ;
    rdfs:range divvy:CategorieUtilisateur .

divvy:concernePeriode a owl:ObjectProperty ;
    rdfs:domain divvy:ObservationTrajets ;
    rdfs:range divvy:Periode .

divvy:concerneStation a owl:ObjectProperty ;
    rdfs:domain divvy:ObservationTrajets ;
    rdfs:range divvy:Station .

divvy:concerneVehicule a owl:ObjectProperty ;
    rdfs:domain divvy:ObservationTrajets ;
    rdfs:range divvy:TypeVehicule .

divvy:heure a owl:DatatypeProperty ;
    rdfs:domain divvy:Periode ;
    rdfs:range xsd:integer .

divvy:identifiantStation a owl:DatatypeProperty ;
    rdfs:domain divvy:Station ;
    rdfs:range xsd:string .

divvy:jourSemaine a owl:DatatypeProperty ;
    rdfs:domain divvy:Periode ;
    rdfs:range xsd:integer .

divvy:mois a owl:DatatypeProperty ;
    rdfs:domain divvy:Periode ;
    rdfs:range xsd:integer .

divvy:nomStation a owl:DatatypeProperty ;
    rdfs:domain divvy:Station ;
    rdfs:range xsd:string .

divvy:nombreTotalTrajets a owl:DatatypeProperty ;
    rdfs:domain divvy:ObservationTrajets ;
    rdfs:range xsd:integer .

divvy:nombreTrajetsAbonnes a owl:DatatypeProperty ;
    rdfs:domain divvy:ObservationTrajets ;
    rdfs:range xsd:integer .

divvy:nombreTrajetsCategorie a owl:DatatypeProperty ;
    rdfs:domain divvy:RepartitionCategorie ;
    rdfs:range xsd:integer .

divvy:nombreTrajetsOccasionnels a owl:DatatypeProperty ;
    rdfs:domain divvy:ObservationTrajets ;
    rdfs:range xsd:integer .

divvy:partOccasionnelle a owl:DatatypeProperty ;
    rdfs:domain divvy:ObservationTrajets ;
    rdfs:range xsd:decimal .

divvy:possedeRepartition a owl:ObjectProperty ;
    rdfs:domain divvy:ObservationTrajets ;
    rdfs:range divvy:RepartitionCategorie .

